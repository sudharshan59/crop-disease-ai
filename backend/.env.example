# ═══════════════════════════════════════════════════════════════
# Crop Disease AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your environment.
# Usage: cp .env.example .env

# ── API Settings ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── CNN Model ─────────────────────────────────────────────────
# Path to trained model weights (relative or absolute)
# MODEL_PATH=models/plant_disease_model.pth
# TORCHSCRIPT_PATH=models/plant_disease_model_scripted.pt

# Device: 'auto' (detect GPU/CPU), 'cpu', or 'cuda'
DEVICE=auto

# ── LLM Settings ─────────────────────────────────────────────
# Backend: 'gguf' (llama-cpp-python, CPU) or 'bitsandbytes' (HuggingFace, GPU)
LLM_BACKEND=gguf

# GGUF model path (for gguf backend)
# Download from: https://huggingface.co/TheBloke/phi-2-GGUF
# Recommended: phi-2.Q4_K_M.gguf (~1.8GB)
# LLM_GGUF_PATH=models/phi-2.Q4_K_M.gguf

# HuggingFace model name (for bitsandbytes backend)
# LLM_MODEL_NAME=microsoft/phi-2

# Generation parameters
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_CONTEXT_LENGTH=2048

# ── Database ──────────────────────────────────────────────────
# DB_PATH=data/predictions.db

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PROMPTS=True
